# Copy to .env. Every variable is optional; the defaults match compose.yaml
# when the commands run on the host. Inside Compose the services override the
# host names (kafka:9092, postgres) themselves.

# Logging: auto (JSON unless stderr is a terminal), json or console.
TRIBUTARY_LOG_FORMAT=auto
TRIBUTARY_LOG_LEVEL=INFO

# Kafka bootstrap servers. 9094 is the broker's host-facing listener.
TRIBUTARY_KAFKA_BOOTSTRAP=localhost:9094
# Topic the producer writes and the stream job reads.
TRIBUTARY_TOPIC=wiki.recentchange
# Partitions used when the topic is first created.
TRIBUTARY_TOPIC_PARTITIONS=3

# PostgreSQL warehouse.
TRIBUTARY_PG_HOST=localhost
TRIBUTARY_PG_PORT=5432
TRIBUTARY_PG_DATABASE=tributary
TRIBUTARY_PG_USER=tributary
TRIBUTARY_PG_PASSWORD=tributary

# Producer: the committed sample, replay rate in events/s (0 = unthrottled),
# the live stream URL and the User-Agent Wikimedia asks clients to set.
TRIBUTARY_SAMPLE_PATH=data/sample/recentchange.jsonl.gz
TRIBUTARY_PRODUCE_RATE=500
TRIBUTARY_LIVE_URL=https://stream.wikimedia.org/v2/stream/recentchange
TRIBUTARY_USER_AGENT=tributary/0.1 (https://github.com/TheAsianFish/tributary)

# Spark stream job.
TRIBUTARY_CHECKPOINT_DIR=spark-checkpoints/warehouse
# How far behind the newest event time an event may arrive and still be kept.
TRIBUTARY_WATERMARK_DELAY=10 minutes
TRIBUTARY_TRIGGER_INTERVAL=2 seconds
TRIBUTARY_MAX_OFFSETS_PER_TRIGGER=100000
# postgres (default); python and noop are the benchmark's stage ceilings (no rows land).
TRIBUTARY_STREAM_SINK=postgres
# Compose only: the stream container's checkpoint root (warehouse/ and lake/ under it).
# The benchmarks point it at a per-run directory; leave it unset otherwise.
# TRIBUTARY_STREAM_CHECKPOINTS=/data/checkpoints
TRIBUTARY_SPARK_MASTER=local[3]
# Kafka connector, Iceberg runtime, its S3 client and the PostgreSQL driver,
# resolved from Maven on the host; the stream image sets this to an empty
# string because the jars are baked in.
TRIBUTARY_SPARK_PACKAGES=org.apache.spark:spark-sql-kafka-0-10_2.13:4.1.3,org.apache.iceberg:iceberg-spark-runtime-4.1_2.13:1.11.0,org.apache.iceberg:iceberg-aws-bundle:1.11.0,org.postgresql:postgresql:42.7.14

# Lakehouse: the stream job's second query appends to the Iceberg table
# lake.raw.recentchange (false = warehouse only).
TRIBUTARY_LAKE_ENABLED=true
TRIBUTARY_LAKE_CHECKPOINT_DIR=spark-checkpoints/lake
# Each lake trigger commits a snapshot and writes a file per hour touched.
TRIBUTARY_LAKE_TRIGGER_INTERVAL=1 minute
TRIBUTARY_LAKE_MAX_OFFSETS_PER_TRIGGER=2000000
# S3-compatible object store (MinIO in Compose). The keys are MinIO's root
# credentials there; the secret must be at least 8 characters.
TRIBUTARY_S3_ENDPOINT=http://localhost:9000
TRIBUTARY_S3_REGION=us-east-1
TRIBUTARY_S3_ACCESS_KEY=tributary
TRIBUTARY_S3_SECRET_KEY=tributary-dev-secret
TRIBUTARY_LAKE_WAREHOUSE=s3://lake/warehouse
# PostgreSQL schema holding the Iceberg JDBC catalog (shared by Spark and Trino).
TRIBUTARY_ICEBERG_CATALOG_SCHEMA=iceberg_catalog
# Snapshot and orphan-file retention for lake_maintenance (Trino's floor is set
# to the same 1d in docker/trino/catalog/iceberg.properties).
TRIBUTARY_LAKE_SNAPSHOT_RETENTION=1d
# Closed hours compared between the warehouse and the lake on each run, and how
# far (event time) the lake may trail the warehouse before it is flagged.
TRIBUTARY_RECONCILE_LOOKBACK_HOURS=24
TRIBUTARY_LAKE_MAX_LAG_MINUTES=15

# Trino (profile lakehouse), host port.
TRIBUTARY_TRINO_HOST=localhost
TRIBUTARY_TRINO_PORT=8081
TRIBUTARY_TRINO_USER=tributary
TRIBUTARY_TRINO_LAKE_TABLE=iceberg.raw.recentchange

# Warehouse: the dbt project and where the agent's catalog is published
# (manifest.json, catalog.json, values.json under <dir>/current).
TRIBUTARY_DBT_PROJECT_DIR=warehouse
# Extra dbt vars for every run, e.g. {freshness_severity: warn} during a backfill.
TRIBUTARY_DBT_VARS=
TRIBUTARY_CATALOG_DIR=catalog
# Read-only role created on first start (Trino's postgresql catalog).
TRIBUTARY_READER_USER=tributary_reader
TRIBUTARY_READER_PASSWORD=tributary_reader
# The agent's role: SELECT on marts and ops only, read-only sessions. Created on
# first start; on an existing database run `tributary warehouse grant-agent`.
TRIBUTARY_AGENT_USER=tributary_agent
TRIBUTARY_AGENT_PASSWORD=tributary_agent

# Agent: the model that writes SQL. anthropic reads ANTHROPIC_API_KEY (never put
# it in this repository); ollama talks to a local Ollama; fake replays the
# recordings in TRIBUTARY_RECORDINGS_PATH (what the tests use).
TRIBUTARY_PROVIDER=anthropic
TRIBUTARY_MODEL=claude-opus-5-5
# low, medium, high, xhigh or max (Claude Opus 5.5 defaults to medium).
TRIBUTARY_ANTHROPIC_EFFORT=medium
TRIBUTARY_OLLAMA_URL=http://localhost:11434
TRIBUTARY_OLLAMA_MODEL=qwen2.5-coder:7b
TRIBUTARY_RECORDINGS_PATH=tests/recordings/warehouse.jsonl
# Repairs after a blocked or failing query, rows returned at most, the statement
# timeout, the EXPLAIN cost above which a query is refused, the bytes of values a
# result may hold (counted by PostgreSQL before it sends a row; 8 MiB), and how old a
# mart's last rebuild may be before answers flag it as stale.
# Schema linking: full (every table), bm25 (the k best lexical matches) or core
# (value matching and join paths; not implemented yet, refused at start-up).
TRIBUTARY_AGENT_LINKER=full
TRIBUTARY_AGENT_LINK_K=4
# Planner features (RESULTS.md, M7): hint the indexed values a question names, show up
# to N worked examples from the marts' dbt docs (meta.examples), and vote over N draws
# by the rows each query returns.
TRIBUTARY_AGENT_VALUES=false
TRIBUTARY_AGENT_EXAMPLES=0
TRIBUTARY_AGENT_VOTES=1
TRIBUTARY_AGENT_MAX_REPAIRS=2
TRIBUTARY_AGENT_ROW_CAP=1000
TRIBUTARY_AGENT_STATEMENT_TIMEOUT_MS=10000
TRIBUTARY_AGENT_COST_CEILING=1000000
TRIBUTARY_AGENT_MAX_RESULT_BYTES=8388608
TRIBUTARY_AGENT_STALE_AFTER_MINUTES=120

# BIRD Mini-Dev (`make bird`, `make eval`): the benchmark databases are loaded into
# their own database on the same server, one schema per BIRD database, and every
# predicted and gold query runs as a read-only role. Downloads are cached here.
TRIBUTARY_BIRD_DATABASE=bird
TRIBUTARY_BIRD_USER=tributary_bird
TRIBUTARY_BIRD_PASSWORD=tributary_bird
# TRIBUTARY_BIRD_CACHE_DIR=~/.cache/tributary/bird

# API (`tributary serve`, profile api): comma-separated keys accepted in the
# X-API-Key header. There is no default; the API refuses to start without one.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TRIBUTARY_API_KEYS=
TRIBUTARY_API_HOST=127.0.0.1
TRIBUTARY_API_PORT=8000
# Per-key rate limit (token bucket): BURST requests at once, refilled at
# PER_MINUTE; past it the API answers 429 with Retry-After. 0 disables. The
# buckets are per process: N uvicorn workers or replicas admit N times this.
TRIBUTARY_API_RATE_LIMIT_PER_MINUTE=60
TRIBUTARY_API_RATE_LIMIT_BURST=10
# Request bodies over this many bytes are refused with 413 before parsing (min 1024).
TRIBUTARY_API_MAX_BODY_BYTES=65536
# /metrics (Prometheus text) needs the API key unless this is true; it never
# counts toward the rate limit.
TRIBUTARY_API_METRICS_PUBLIC=false
# Serve the interactive docs (/docs, /redoc, /openapi.json); off by default.
TRIBUTARY_API_DOCS=false
# Client side: the key `tributary ask --api URL` sends.
TRIBUTARY_API_KEY=

# Airflow (profile airflow): signing keys for the API server's tokens and sessions.
# The UI's simple auth makes every user admin; change both before any shared host.
AIRFLOW_JWT_SECRET=tributary-dev-jwt-secret-change-me
AIRFLOW_API_SECRET_KEY=tributary-dev-api-secret-change-me

# Not used yet (agent, from M3).
ANTHROPIC_API_KEY=
