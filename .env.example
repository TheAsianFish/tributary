# Copy to .env. Every variable is optional; the defaults match compose.yaml
# when the commands run on the host. Inside Compose the services override the
# host names (kafka:9092, postgres) themselves.

# Logging: auto (JSON unless stderr is a terminal), json or console.
TRIBUTARY_LOG_FORMAT=auto
TRIBUTARY_LOG_LEVEL=INFO

# Kafka bootstrap servers. 9094 is the broker's host-facing listener.
TRIBUTARY_KAFKA_BOOTSTRAP=localhost:9094
# Topic the producer writes and the stream job reads.
TRIBUTARY_TOPIC=wiki.recentchange
# Partitions used when the topic is first created.
TRIBUTARY_TOPIC_PARTITIONS=3

# PostgreSQL warehouse.
TRIBUTARY_PG_HOST=localhost
TRIBUTARY_PG_PORT=5432
TRIBUTARY_PG_DATABASE=tributary
TRIBUTARY_PG_USER=tributary
TRIBUTARY_PG_PASSWORD=tributary

# Producer: the committed sample, replay rate in events/s (0 = unthrottled),
# the live stream URL and the User-Agent Wikimedia asks clients to set.
TRIBUTARY_SAMPLE_PATH=data/sample/recentchange.jsonl.gz
TRIBUTARY_PRODUCE_RATE=500
TRIBUTARY_LIVE_URL=https://stream.wikimedia.org/v2/stream/recentchange
TRIBUTARY_USER_AGENT=tributary/0.1 (https://github.com/TheAsianFish/tributary)

# Spark stream job.
TRIBUTARY_CHECKPOINT_DIR=spark-checkpoints/warehouse
# How far behind the newest event time an event may arrive and still be kept.
TRIBUTARY_WATERMARK_DELAY=10 minutes
TRIBUTARY_TRIGGER_INTERVAL=5 seconds
TRIBUTARY_MAX_OFFSETS_PER_TRIGGER=20000
TRIBUTARY_SPARK_MASTER=local[3]
# Kafka connector, Iceberg runtime, its S3 client and the PostgreSQL driver,
# resolved from Maven on the host; the stream image sets this to an empty
# string because the jars are baked in.
TRIBUTARY_SPARK_PACKAGES=org.apache.spark:spark-sql-kafka-0-10_2.13:4.1.3,org.apache.iceberg:iceberg-spark-runtime-4.1_2.13:1.11.0,org.apache.iceberg:iceberg-aws-bundle:1.11.0,org.postgresql:postgresql:42.7.14

# Lakehouse: the stream job's second query appends to the Iceberg table
# lake.raw.recentchange (false = warehouse only).
TRIBUTARY_LAKE_ENABLED=true
TRIBUTARY_LAKE_CHECKPOINT_DIR=spark-checkpoints/lake
# Each lake trigger commits a snapshot and writes a file per hour touched.
TRIBUTARY_LAKE_TRIGGER_INTERVAL=1 minute
TRIBUTARY_LAKE_MAX_OFFSETS_PER_TRIGGER=200000
# S3-compatible object store (MinIO in Compose). The keys are MinIO's root
# credentials there; the secret must be at least 8 characters.
TRIBUTARY_S3_ENDPOINT=http://localhost:9000
TRIBUTARY_S3_REGION=us-east-1
TRIBUTARY_S3_ACCESS_KEY=tributary
TRIBUTARY_S3_SECRET_KEY=tributary-dev-secret
TRIBUTARY_LAKE_WAREHOUSE=s3://lake/warehouse
# PostgreSQL schema holding the Iceberg JDBC catalog (shared by Spark and Trino).
TRIBUTARY_ICEBERG_CATALOG_SCHEMA=iceberg_catalog
# Snapshot and orphan-file retention for lake_maintenance (Trino's floor is set
# to the same 1d in docker/trino/catalog/iceberg.properties).
TRIBUTARY_LAKE_SNAPSHOT_RETENTION=1d
# Closed hours compared between the warehouse and the lake on each run, and how
# far (event time) the lake may trail the warehouse before it is flagged.
TRIBUTARY_RECONCILE_LOOKBACK_HOURS=24
TRIBUTARY_LAKE_MAX_LAG_MINUTES=15

# Trino (profile lakehouse), host port.
TRIBUTARY_TRINO_HOST=localhost
TRIBUTARY_TRINO_PORT=8081
TRIBUTARY_TRINO_USER=tributary
TRIBUTARY_TRINO_LAKE_TABLE=iceberg.raw.recentchange

# Warehouse: the dbt project and where the agent's catalog is published
# (manifest.json, catalog.json, values.json under <dir>/current).
TRIBUTARY_DBT_PROJECT_DIR=warehouse
# Extra dbt vars for every run, e.g. {freshness_severity: warn} during a backfill.
TRIBUTARY_DBT_VARS=
TRIBUTARY_CATALOG_DIR=catalog
# Read-only role created on first start (Trino's postgresql catalog; the agent from M3).
TRIBUTARY_READER_USER=tributary_reader
TRIBUTARY_READER_PASSWORD=tributary_reader

# Not used yet (agent, from M3).
ANTHROPIC_API_KEY=
