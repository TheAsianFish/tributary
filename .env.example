# Copy to .env. Every variable is optional; the defaults match compose.yaml
# when the commands run on the host. Inside Compose the services override the
# host names (kafka:9092, postgres) themselves.

# Logging: auto (JSON unless stderr is a terminal), json or console.
TRIBUTARY_LOG_FORMAT=auto
TRIBUTARY_LOG_LEVEL=INFO

# Kafka bootstrap servers. 9094 is the broker's host-facing listener.
TRIBUTARY_KAFKA_BOOTSTRAP=localhost:9094
# Topic the producer writes and the stream job reads.
TRIBUTARY_TOPIC=wiki.recentchange
# Partitions used when the topic is first created.
TRIBUTARY_TOPIC_PARTITIONS=3

# PostgreSQL warehouse.
TRIBUTARY_PG_HOST=localhost
TRIBUTARY_PG_PORT=5432
TRIBUTARY_PG_DATABASE=tributary
TRIBUTARY_PG_USER=tributary
TRIBUTARY_PG_PASSWORD=tributary

# Producer: the committed sample, replay rate in events/s (0 = unthrottled),
# the live stream URL and the User-Agent Wikimedia asks clients to set.
TRIBUTARY_SAMPLE_PATH=data/sample/recentchange.jsonl.gz
TRIBUTARY_PRODUCE_RATE=500
TRIBUTARY_LIVE_URL=https://stream.wikimedia.org/v2/stream/recentchange
TRIBUTARY_USER_AGENT=tributary/0.1 (https://github.com/TheAsianFish/tributary)

# Spark stream job.
TRIBUTARY_CHECKPOINT_DIR=spark-checkpoints/warehouse
# How far behind the newest event time an event may arrive and still be kept.
TRIBUTARY_WATERMARK_DELAY=10 minutes
TRIBUTARY_TRIGGER_INTERVAL=5 seconds
TRIBUTARY_MAX_OFFSETS_PER_TRIGGER=20000
TRIBUTARY_SPARK_MASTER=local[3]
# Kafka connector resolved from Maven on the host; the stream image sets this
# to an empty string because the jars are baked in.
TRIBUTARY_SPARK_PACKAGES=org.apache.spark:spark-sql-kafka-0-10_2.13:4.1.3

# Not used yet (agent, from M3).
ANTHROPIC_API_KEY=
