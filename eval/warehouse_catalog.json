{
 "examples": [
  {
   "question": "Who are the 10 busiest bot accounts on Wikidata? Return the account name and its edit count.",
   "source": "marts.agg_editor_activity",
   "sql": "SELECT user_name, edits\nFROM marts.agg_editor_activity\nWHERE wiki = 'wikidatawiki' AND is_bot\nORDER BY edits DESC, user_name\nLIMIT 10"
  },
  {
   "question": "Which logged-in human contributors to English Wikipedia grew it by the most net bytes? Return the top 10 names, their net bytes and pages edited.",
   "source": "marts.agg_editor_activity",
   "sql": "SELECT user_name, net_bytes, pages_edited\nFROM marts.agg_editor_activity\nWHERE wiki = 'enwiki' AND NOT is_bot AND NOT is_anonymous\nORDER BY net_bytes DESC, user_name\nLIMIT 10"
  },
  {
   "question": "How many accounts on Hebrew Wikipedia touched exactly one page? Return one number.",
   "source": "marts.agg_editor_activity",
   "sql": "SELECT count(*) AS single_page_editors\nFROM marts.agg_editor_activity\nWHERE wiki = 'hewiki' AND pages_edited = 1"
  },
  {
   "question": "On average, how many edits did Spanish Wikipedia get per active hour? Return the average rounded to 1 decimal place.",
   "source": "marts.agg_edits_hourly",
   "sql": "SELECT round(avg(edits), 1) AS avg_edits_per_hour\nFROM marts.agg_edits_hourly\nWHERE wiki = 'eswiki'"
  },
  {
   "question": "In each UTC hour, which wiki gained the most content in bytes? Return the hour, the wiki and its bytes added.",
   "source": "marts.agg_edits_hourly",
   "sql": "SELECT DISTINCT ON (event_hour) event_hour, wiki, bytes_added\nFROM marts.agg_edits_hourly\nORDER BY event_hour, bytes_added DESC, wiki"
  },
  {
   "question": "Which 5 wikis shrank the most, removing more bytes than they added? Return the wiki, bytes added and bytes removed.",
   "source": "marts.agg_edits_hourly",
   "sql": "SELECT wiki, sum(bytes_added) AS bytes_added, sum(bytes_removed) AS bytes_removed\nFROM marts.agg_edits_hourly\nGROUP BY wiki\nHAVING sum(bytes_removed) > sum(bytes_added)\nORDER BY sum(bytes_removed) - sum(bytes_added) DESC, wiki\nLIMIT 5"
  },
  {
   "question": "Which 10 category pages on Wikimedia Commons had the most distinct editors? Return the title and the editor count.",
   "source": "marts.dim_page",
   "sql": "SELECT title, distinct_editors\nFROM marts.dim_page\nWHERE wiki = 'commonswiki' AND namespace = 14\nORDER BY distinct_editors DESC, title\nLIMIT 10"
  },
  {
   "question": "On Russian Wikipedia, how many pages that already existed before the data began were touched, per namespace? Return the namespace name and the page count.",
   "source": "marts.dim_page",
   "sql": "SELECT namespace_name, count(*) AS pages\nFROM marts.dim_page\nWHERE wiki = 'ruwiki' AND NOT created_in_window\nGROUP BY namespace_name\nORDER BY pages DESC, namespace_name"
  },
  {
   "question": "Which Wikisource pages saw the most activity? Return the wiki, its language code, the title and the edit count for the top 10.",
   "source": "marts.dim_page",
   "sql": "SELECT p.wiki, w.language_code, p.title, p.edits\nFROM marts.dim_page AS p\nJOIN marts.dim_wiki AS w ON w.wiki = p.wiki\nWHERE w.project_family = 'wikisource'\nORDER BY p.edits DESC, p.wiki, p.title\nLIMIT 10"
  },
  {
   "question": "Which 10 wikis have the largest number of log actions and categorisation events? Return the wiki and that count.",
   "source": "marts.dim_wiki",
   "sql": "SELECT wiki, events - edits AS other_events\nFROM marts.dim_wiki\nORDER BY other_events DESC, wiki\nLIMIT 10"
  },
  {
   "question": "List the Wikivoyage wikis with their domain and language code.",
   "source": "marts.dim_wiki",
   "sql": "SELECT wiki, domain, language_code\nFROM marts.dim_wiki\nWHERE project_family = 'wikivoyage'\nORDER BY wiki"
  },
  {
   "question": "For each Wikiquote wiki, how many minutes passed between its first and last event? Return the wiki and the minutes rounded to 1 decimal place.",
   "source": "marts.dim_wiki",
   "sql": "SELECT wiki, round(extract(epoch FROM last_event_ts - first_event_ts) / 60, 1) AS active_minutes\nFROM marts.dim_wiki\nWHERE project_family = 'wikiquote'\nORDER BY active_minutes DESC, wiki"
  },
  {
   "question": "What was the average page size in bytes after edits to File pages on Wikimedia Commons? Return the average rounded to the nearest byte.",
   "source": "marts.fct_edits",
   "sql": "SELECT round(avg(length_new)) AS avg_bytes\nFROM marts.fct_edits\nWHERE wiki = 'commonswiki' AND namespace = 6"
  },
  {
   "question": "What were the 10 most recent edits to User pages on Spanish Wikipedia? Return the title, the editor and the edit time, newest first.",
   "source": "marts.fct_edits",
   "sql": "SELECT title, user_name, event_ts\nFROM marts.fct_edits\nWHERE wiki = 'eswiki' AND namespace = 2\nORDER BY event_ts DESC, event_id\nLIMIT 10"
  },
  {
   "question": "What share of Italian Wikipedia's patrollable edits were patrolled? Return the percentage rounded to 1 decimal place.",
   "source": "marts.fct_edits",
   "sql": "SELECT round(100.0 * count(*) FILTER (WHERE is_patrolled) / nullif(count(is_patrolled), 0), 1)\n  AS pct_patrolled\nFROM marts.fct_edits\nWHERE wiki = 'itwiki'"
  }
 ],
